# Generated by `node scripts/check-env.mjs --write-example` — DO NOT EDIT BY HAND.
# Source of truth: env.schema.json
#
# Copy to .env.local and fill in. Values here are placeholders, never real
# secrets. .env.e2e has its own example file (.env.e2e.example).

# ── Client (baked into the browser bundle — public by definition) ───────
# Read by src/convex.ts in the browser. Once the Vercel build runs `npx
# convex deploy --cmd-url-env-var-name VITE_CONVEX_URL`, the deploy INJECTS
# this and you should not set it by hand on Vercel. Still needed locally,
# where `npx convex dev` writes it into .env.local.
VITE_CONVEX_URL=

# Client bundle (src/hooks/usePushNotifications.ts). Public by design; must
# equal VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=

# ── Vercel server runtime ───────────────────────────────────────────────
# Server-side preference in src/routes/api/*. Falls back to VITE_CONVEX_URL,
# then to http://127.0.0.1:3210, so a missing value degrades silently to
# localhost in production — set it or rely on the injected VITE_CONVEX_URL.
CONVEX_URL=

# Vercel server only, for the AI quote extract/compare routes.
OPENAI_API_KEY=CHANGE_ME

# Vercel server only. src/routes/api/webhook/polar.ts asserts it non-null
# with `!`, so a missing value is a runtime crash on webhook delivery.
POLAR_WEBHOOK_SECRET=CHANGE_ME

# Not read by app code — consumed by `npx convex deploy` in the Vercel
# build. Needs TWO separate entries under the same name: a Production deploy
# key scoped to the Production environment only, and a Preview deploy key
# scoped to Preview only. The Preview key is what gives each branch its own
# Convex backend.
CONVEX_DEPLOY_KEY=CHANGE_ME

# ── Convex deployment ───────────────────────────────────────────────────
# Convex-only. Used for email OTP links (convex/ResendOTP.ts) and the Polar
# portal return URL (convex/users.ts). Defaults to https://buildsync.co.il,
# so a wrong value sends users to the wrong host rather than failing loudly.
SITE_URL=

# Convex-only. Resend key used by the auth email OTP provider.
AUTH_RESEND_KEY=CHANGE_ME

# Convex-only, OPTIONAL. convex/support.ts falls back to AUTH_RESEND_KEY,
# because both are plain Resend API keys for the same account and the same
# verified domain (buildsync.co.il) — Resend scopes keys by domain, not by
# sender address. Set this only if you want a separate key for support mail
# that can be rotated independently of auth mail. It was unset for the whole
# life of the project, which silently disabled every support-ticket
# notification.
RESEND_API_KEY=CHANGE_ME

# Convex-only. Recipient for support notifications; defaults to
# support@buildsync.co.il.
ADMIN_EMAIL=

# Convex-only (convex/pushActions.ts). MUST equal VITE_VAPID_PUBLIC_KEY —
# the browser subscribes with the client copy and Convex signs with this
# one, so a mismatch makes every push silently fail.
VAPID_PUBLIC_KEY=

# Convex-only. The signing half of the VAPID pair.
VAPID_PRIVATE_KEY=CHANGE_ME

# ── Set in BOTH Convex and Vercel — keep them identical ─────────────────
# DUAL HOME. Vercel needs it for checkout + webhook; Convex needs it for the
# customer portal URL (convex/users.ts). Rotating it means updating BOTH
# systems.
POLAR_ACCESS_TOKEN=CHANGE_ME

# DUAL HOME, and it must MATCH across both: src/server/billing/products.ts
# picks the plan→product id map from it while convex/users.ts builds the
# portal from it. A mismatch silently points checkout and portal at
# different Polar environments. Defaults to 'sandbox' everywhere it is read.
POLAR_SERVER=sandbox|production

# DUAL HOME and must be BYTE-IDENTICAL in Convex and Vercel. The Polar
# webhook route sends it; convex/users.ts compares it. If they differ,
# subscription sync fails silently and paid users keep free-tier
# entitlements. check-env.mjs compares sha256 hashes so a mismatch is
# detectable without printing the secret.
SUBSCRIPTION_SYNC_SECRET=CHANGE_ME

# ── Local / Playwright only ─────────────────────────────────────────────
# Playwright only. Lives in the git-ignored .env.e2e. Dev/local accounts
# only — never a production user.
E2E_EMAIL=

# Playwright only, from .env.e2e.
E2E_PASSWORD=CHANGE_ME

# Optional. Points Playwright at a deployed URL instead of a local server.
E2E_BASE_URL=

# Optional. Port for playwright.build.config.ts; defaults to 3100,
# deliberately not 3000 so a running dev server can never be tested by
# mistake.
E2E_BUILD_PORT=

# ── Provided by the platform — do not set ───────────────────────────────
# Read by convex/auth.config.ts. Convex sets this automatically on every
# deployment — do NOT set it yourself.
# CONVEX_SITE_URL=

# Set by the tooling. src/server/billing/products.ts uses it to pick the
# default Polar server.
# NODE_ENV=

# Vercel-provided: 'production' | 'preview' | 'development'. Read by
# src/utils/envGuard.ts so a missing-variable error can name which
# environment it happened in.
# VERCEL_ENV=

# Vercel-provided. vite.config.ts bakes it into VITE_BUILD_ID.
# VERCEL_GIT_COMMIT_SHA=

# Vercel-provided. Fallback for VITE_BUILD_ID.
# VERCEL_DEPLOYMENT_ID=
